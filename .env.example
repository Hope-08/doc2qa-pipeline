# LLM API Keys
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
# 或使用其他兼容 OpenAI 的 API
# OPENAI_API_BASE=https://api.example.com/v1

# Prefect 配置（可选，用于监控面板）
PREFECT_API_URL=http://localhost:4200/api
PREFECT_LOGGING_LEVEL=INFO

# 模型配置
LLM_MODEL=azure-openai/gpt-5.4         # simple 策略 QA 生成模型
NLI_MODEL=azure-openai/gpt-5.4         # Faithfulness 评分 LLM（质量优先）
SYNTHESIZE_MODEL=azure-openai/gpt-5.4  # advanced 策略 QA 合成模型（质量优先）
ENTITY_EXTRACTOR_MODEL=azure-openai/gpt-4o  # 实体提取 + 自一致性验证模型
EMBEDDING_MODEL=azure-openai/text-embedding-3-small

# QA 生成策略（两阶段高质量方案）
QA_STRATEGY=advanced          # simple（旧方案 3条/chunk）| advanced（≤N条/文档，多跳推理）
MAX_QA_PER_DOC=10             # 单文档 QA 上限
SELF_CONSISTENCY_CHECK=true   # 是否启用自一致性验证（过滤常识题）

# 分块配置
CHUNK_SIZE=800                # 单块目标字符数（约 500 tokens，对齐 RAGAS 最小块）
HEADLINE_MIN_COUNT=2          # ≥N 个标题时启用 HeadlineSplitter 按节切分

# 文档解析配置（本地多引擎，无需 GPU 服务）
PARSING_BACKEND=auto      # auto | docling | pymupdf | unstructured
OCR_LANG=chi_sim+eng      # Tesseract 语言包，多语言用 + 分隔

# API 服务配置（可选）
# 生产环境应设置为实际域名，默认仅允许本地访问
# CORS_ORIGINS=["https://yourapp.com","https://admin.yourapp.com"]
